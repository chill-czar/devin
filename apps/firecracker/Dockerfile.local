FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl iproute2 iptables conntrack \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/cni/bin /etc/cni/conf.d /var/run/netns /var/lib/cni /tmp/devin-vms

COPY bin/cni/ /opt/cni/bin/
RUN chmod 755 /opt/cni/bin/*

COPY bin/firecracker /usr/bin/firecracker
RUN chmod 755 /usr/bin/firecracker

COPY bin/firecracker-daemon /usr/bin/firecracker-daemon
RUN chmod 755 /usr/bin/firecracker-daemon

COPY config/cni/fcnet.conflist /etc/cni/conf.d/
COPY config/cni/resolv.conf /etc/cni/resolv.conf

ENV FIRECRACKER_BIN=/usr/bin/firecracker \
    FIRECRACKER_CNI_CONF_DIR=/etc/cni/conf.d \
    FIRECRACKER_CNI_BIN_PATH=/opt/cni/bin \
    FIRECRACKER_CNI_NETWORK=fcnet \
    FIRECRACKER_SNAPSHOT_DIR=/tmp/devin-snapshots \
    FIRECRACKER_KERNEL_PATH=/tmp/vmlinux.bin \
    FIRECRACKER_VMM_DIR=/tmp/devin-vms \
    FIRECRACKER_DRY_RUN=false \
    FIRECRACKER_HOST_PORT=9093 \
    FIRECRACKER_DEFAULT_RUNTIME=node \
    FIRECRACKER_POOL_SIZE=1 \
    FIRECRACKER_WARM_VCPU=2 \
    FIRECRACKER_WARM_MEMORY_MIB=8192 \
    FIRECRACKER_MAX_ACTIVE_VMS=10 \
    FIRECRACKER_MIN_FREE_DISK_GIB=5

EXPOSE 9093
ENTRYPOINT ["/usr/bin/firecracker-daemon"]
